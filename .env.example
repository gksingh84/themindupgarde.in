# ====================================================================
# THE MIND UPGRADE — PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================

# Node Environment
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://themindupgrade.in"

# 1. PostgreSQL Database Connection String
# Examples:
# AWS RDS: postgresql://admin_user:password@db-cluster.ap-south-1.rds.amazonaws.com:5432/themindupgrade?schema=public
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local: postgresql://postgres:postgres@localhost:5432/themindupgrade?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/themindupgrade?schema=public"

# 2. Admin Authentication & Security
ADMIN_PASSWORD="adminpassword@7531"
NEXT_PUBLIC_ADMIN_PASSWORD="adminpassword@7531"
JWT_SECRET="generate-a-strong-random-32-byte-hex-string"

# 3. AWS S3 & CloudFront Configuration (Optional for cloud media storage)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AWS_S3_BUCKET_NAME="themindupgrade-media-production"
NEXT_PUBLIC_CLOUDFRONT_URL="https://d123456abcdef.cloudfront.net"

# 4. Email Notifications (Amazon SES / Brevo / SMTP)
SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"
SMTP_PORT=587
SMTP_USER="AKIAxxxxxxxxxxxxxxxx"
SMTP_PASS="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SMTP_FROM="The Mind Upgrade <newsletter@themindupgrade.in>"
ADMIN_NOTIFICATION_EMAIL="gaurav@themindupgrade.in"
